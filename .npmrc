# nitro@3.0.0 (последняя версия на npm) ещё объявляет peer vite@^7, а
# @tanstack/react-start требует vite>=8 — в коде nitro на GitHub это уже
# помечено как совместимое с ^7 || ^8, но опубликованный npm-пакет ещё не
# обновлён. legacy-peer-deps отключает строгую проверку таких
# необязательных (peerOptional) конфликтов вместо падения npm install.
legacy-peer-deps=true
